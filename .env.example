# Server
PORT=3000
NODE_ENV=production

# Firebase Admin SDK — download this JSON from:
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
#
# Running via Docker (docker-compose.yml mounts the real file to this exact
# path inside the container) — leave this as-is:
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
#
# Running directly with `node server.js` (no Docker) instead — use the
# actual path on the VM's filesystem, e.g.:
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/scholario-backend/firebase-service-account.json

# CORS — comma-separated list of origins allowed to call this API.
# For a native Android app calling via HTTPS this can usually stay permissive,
# but keep it explicit rather than "*" once you add an admin web panel.
ALLOWED_ORIGINS=https://yourdomain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200



STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database — your real Supabase connection string.
# Supabase dashboard → Project Settings → Database → Connection string →
# choose "Transaction" pooling mode (built for exactly this workload).
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Leave unset/true against Supabase (it requires SSL). Only set to
# "false" for a local Postgres you're running yourself with no SSL,
# e.g. while following PHASE2.md's local testing instructions.
# DATABASE_SSL=false
